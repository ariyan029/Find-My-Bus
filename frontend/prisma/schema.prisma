datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Stop {
  id          String      @id @default(uuid())
  name        String
  bengaliName String?     @map("bengali_name")
  code        String?     @unique
  latitude    Float
  longitude   Float
  landmark    String?
  zone        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  routeStops  RouteStop[]

  @@map("stops")
}

model Route {
  id                  String          @id @default(uuid())
  routeNumber         String          @unique @map("route_number")
  name                String
  source              String
  destination         String
  distanceKm          Float           @map("distance_km")
  totalStops          Int             @map("total_stops")
  busType             String          @map("bus_type")
  operator            String
  averageTripTimeMins Int             @map("average_trip_time_mins")
  fareMin             Int             @map("fare_min")
  fareMax             Int             @map("fare_max")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  routeStops          RouteStop[]
  buses               Bus[]
  telemetryPings      TelemetryPing[]

  @@map("routes")
}

model RouteStop {
  id               String @id @default(uuid())
  routeId          String @map("route_id")
  stopId           String @map("stop_id")
  stopSequence     Int    @map("stop_sequence")
  typicalTimeMins  Int    @map("typical_time_mins")
  fareFromStart    Int    @map("fare_from_start")
  route            Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop             Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopSequence])
  @@map("route_stops")
}

model Bus {
  id               String          @id @default(uuid())
  busNumber        String          @map("bus_number")
  routeId          String?         @map("route_id")
  regNumber        String?         @unique @map("reg_number")
  driverName       String?         @map("driver_name")
  currentLat       Float?          @map("current_lat")
  currentLng       Float?          @map("current_lng")
  heading          Float?          @default(0.0)
  speedKmh         Float?          @default(0.0) @map("speed_kmh")
  status           String          @default("ON_ROUTE")
  occupancyStatus  String          @default("SEATS_AVAILABLE") @map("occupancy_status")
  lastPing         DateTime        @default(now()) @map("last_ping")
  createdAt        DateTime        @default(now()) @map("created_at")
  route            Route?          @relation(fields: [routeId], references: [id])
  telemetryPings   TelemetryPing[]

  @@map("buses")
}

model TelemetryPing {
  id             BigInt   @id @default(autoincrement())
  busId          String?  @map("bus_id")
  routeId        String?  @map("route_id")
  contributorId  String?  @map("contributor_id")
  latitude       Float
  longitude      Float
  accuracyMeters Float?   @map("accuracy_meters")
  speedKmh       Float?   @map("speed_kmh")
  heading        Float?
  recordedAt     DateTime @default(now()) @map("recorded_at")
  bus            Bus?     @relation(fields: [busId], references: [id])
  route          Route?   @relation(fields: [routeId], references: [id])

  @@map("telemetry_pings")
}
