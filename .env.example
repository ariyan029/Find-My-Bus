# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findmybus?schema=public"

# Database Credentials (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=findmybus
POSTGRES_PORT=5432

# Optional shared secret for ESP32 IoT devices (sent via x-device-key header or apiKey field)
# IOT_API_KEY="change-me-in-production"

# Application Brand Settings
NEXT_PUBLIC_APP_NAME="PRAVAH"
NEXT_PUBLIC_APP_TAGLINE="Real-Time Kolkata Transit Network"
NEXT_PUBLIC_DEFAULT_CITY="Kolkata"
NEXT_PUBLIC_DEFAULT_LAT=22.5726
NEXT_PUBLIC_DEFAULT_LNG=88.3639
